{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Android: test, lint and build APK",
      "type": "shell",
      "command": "./gradlew",
      "windows": {"command": ".\\gradlew.bat"},
      "args": ["testDebugUnitTest", "lintDebug", "assembleDebug"],
      "options": {"cwd": "${workspaceFolder}/mobile/android"},
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": []
    },
    {
      "label": "iOS: test game rules (Mac + Swift required)",
      "type": "process",
      "command": "swift",
      "args": ["test"],
      "options": {"cwd": "${workspaceFolder}/mobile/ios"},
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "iOS: generate project (Mac + XcodeGen required)",
      "type": "process",
      "command": "xcodegen",
      "args": ["generate"],
      "options": {"cwd": "${workspaceFolder}/mobile/ios"},
      "problemMatcher": []
    }
  ]
}
